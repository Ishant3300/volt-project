#include? "Pods/Target Support Files/Pods-Runner/Pods-Runner.release.xcconfig"
#include "Generated.xcconfig"

// Default brand name for the plain `Runner` scheme (no flavour selected).
// Flavour configs include this file first and then override via brand-<id>.xcconfig,
// so this only applies when building without a flavour.
APP_DISPLAY_NAME = APEX
