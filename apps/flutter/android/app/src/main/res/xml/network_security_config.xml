<?xml version="1.0" encoding="utf-8"?>
<!--
  Production traffic goes to https://apexlive-api.mynpe.in only — cleartext
  is blocked by default. The debug-overrides block permits it (self-signed
  certs during local testing), and the domain-config below covers the
  emulator/LAN IPs already referenced (commented out) in lib/utils/contants.dart
  for local backend testing, without weakening anything for real users.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">10.178.140.98</domain>
    </domain-config>
    <debug-overrides>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </debug-overrides>
</network-security-config>
